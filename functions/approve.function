{
    "type": "function",
    "function": {
        "name": "approve",
        "description": "approves the current task to move to the next stage of development, and passes along the provided directory to the team working on the next steps.",
        "parameters": {
            "type": "object",
            "properties": {
                "directory": {
                    "type": "string",
                    "description": "The path to the file or folders that will be needed by the next team"
                }
            },
            "required": ["directory"]
        }
    }
}
