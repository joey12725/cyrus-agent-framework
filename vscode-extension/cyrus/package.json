{
  "name": "cyrus-framework-language-support",
  "displayName": "Cyrus framework",
  "description": "Support for .agent, .cflow and .function files in the Cyrus framework.",
  "version": "1.0.0",
  "publisher": "cyrus",
  "license": "MIT",
  "main": "./src/extension.js",
  "engines": {
    "vscode": "^1.58.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "cflow",
        "aliases": [
          "CFlow",
          "cflow"
        ],
        "extensions": [
          ".cflow"
        ],
        "configuration": "./language-configuration/cflow-language-configuration.json"
      },
      {
        "id": "agent",
        "aliases": [
          "Agent",
          "agent"
        ],
        "extensions": [
          ".agent"
        ],
        "configuration": "./language-configuration/agent-language-configuration.json"
      },
      {
        "id": "function",
        "aliases": [
          "Function",
          "function"
        ],
        "extensions": [
          ".function"
        ],
        "configuration": "./language-configuration/function-language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "cflow",
        "scopeName": "source.cflow",
        "path": "./syntaxes/cflow.tmLanguage.json"
      },
      {
        "language": "agent",
        "scopeName": "source.agent",
        "path": "./syntaxes/agent.tmLanguage.json"
      },
      {
        "language": "function",
        "scopeName": "source.function",
        "path": "./syntaxes/function.tmLanguage.json"
      }
    ]
  },
  "activationEvents": [
    "onLanguage:cflow",
    "onLanguage:agent",
    "onLanguage:function"
  ]
}
