{
  "name": "rollDice",
  "dependencies": [
    "requests"
  ],
  "description": "Rolls a specified number of dice, each with a specified number of sides, and optionally adds a specified number to the total sum of all dice rolls.",
  "parameters": {
    "type": "object",
    "properties": {
      "diceCount": {
        "type": "integer",
        "description": "The number of dice to roll."
      },
      "sidesPerDie": {
        "type": "integer",
        "description": "The number of sides on each die."
      },
      "additionalSum": {
        "type": "integer",
        "description": "The number to add to the total sum of dice rolls. This parameter is optional."
      }
    },
    "required": [
      "diceCount",
      "sidesPerDie"
    ]
  },
  "id": "f1c15753-aaa8-4cfe-a5e2-7b309749ae94"
}